{
  "name": "@worldia/marginalia",
  "version": "2.0.0",
  "type": "module",
  "description": "Bot that runs Claude Code reviews on GitLab merge requests, with a studio to read them.",
  "main": "dist/poll.js",
  "bin": {
    "marginalia": "dist/bin/marginalia.js"
  },
  "files": [
    "dist",
    "ui-dist",
    "skills",
    "examples",
    "swiftbar",
    ".env.example"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "tsc -p .",
    "prepack": "npm --workspace @worldia/marginalia-contract run build && tsc -p . && node dist/scripts/bundle-ui.js",
    "start": "node dist/poll.js",
    "init": "node dist/scripts/init.js",
    "doctor": "node dist/scripts/doctor.js",
    "autostart": "node dist/scripts/autostart.js",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p . --noEmit",
    "eval": "tsc -p . && node dist/scripts/eval.js",
    "posthog:backfill": "node dist/scripts/posthog-backfill.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@worldia/marginalia-contract": "2.0.0",
    "commander": "^15.0.0",
    "dotenv": "^16.4.5",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  }
}
