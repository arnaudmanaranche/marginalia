  "components": [
    {
      "name": "Review Card",
      "kind": "card",
      "refersTo": "card",
      "description": "One review on Home: number, age, title, verdict and finding counts, author.",
      "html": "<a class=\"ds-card\" href=\"#\"><div class=\"ds-meta\"><span class=\"ds-mono\">!3909</span><span>6h ago</span></div><h2 class=\"ds-title\">Fix/header skeleton navigation</h2><div class=\"ds-row\"><span class=\"ds-badge ds-badge-red\">Request changes</span><span class=\"ds-chip ds-chip-red\">1 critical</span><span class=\"ds-chip ds-chip-amber\">2 important</span></div></a>",
      "css": ".ds-card{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--line,#27272a);border-radius:12px;background:var(--surface,#18181b);color:var(--text,#f4f4f5);text-decoration:none;font:400 14px/1.43 ui-sans-serif,system-ui,sans-serif;width:320px;transition:border-color .15s}.ds-card:hover{border-color:#3f3f46;box-shadow:0 1px 3px 0 rgb(0 0 0/.1),0 1px 2px -1px rgb(0 0 0/.1)}.ds-card:focus-visible{outline:2px solid #3b82f6;outline-offset:2px}.ds-meta{display:flex;gap:8px;font-size:12px;color:var(--fg-muted,#a1a1aa)}.ds-mono{font-family:ui-monospace,Menlo,monospace}.ds-title{margin:0;font-size:14px;font-weight:500;line-height:1.4}.ds-row{display:flex;flex-wrap:wrap;gap:6px}.ds-badge,.ds-chip{display:inline-flex;align-items:center;border-radius:9999px;padding:2px 8px;font-size:12px}.ds-badge-red{background:rgb(239 68 68/.1);color:#fca5a5;box-shadow:inset 0 0 0 1px rgb(239 68 68/.3)}.ds-chip-red{background:rgb(239 68 68/.1);color:#fca5a5}.ds-chip-amber{background:rgb(245 158 11/.1);color:#fcd34d}"
    },
    {
      "name": "Stat Tile (filter)",
      "kind": "custom",
      "refersTo": "stat-tile",
      "description": "A count that filters the grid; pressed state tints with its status hue.",
      "html": "<button class=\"ds-tile\" aria-pressed=\"false\"><span class=\"ds-num\">8</span><span class=\"ds-lab\">Need changes</span></button>",
      "css": ".ds-tile{display:flex;align-items:center;gap:12px;padding:12px 16px;border:1px solid #27272a;border-radius:12px;background:#18181b;color:#f4f4f5;font:400 14px ui-sans-serif,system-ui,sans-serif;text-align:left;cursor:pointer;transition:border-color .15s,background-color .15s}.ds-tile:hover{border-color:#3f3f46}.ds-tile:focus-visible{outline:2px solid #3b82f6;outline-offset:2px}.ds-tile[aria-pressed=true]{border-color:rgb(239 68 68/.5);background:rgb(239 68 68/.1)}.ds-num{display:block;font-size:24px;font-weight:600;line-height:1;font-variant-numeric:tabular-nums;color:#f87171}.ds-lab{display:block;margin-top:4px;font-size:12px;color:#a1a1aa}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single filled action in a view (Post comment).",
      "html": "<button class=\"ds-btn-primary\">Post comment</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border:0;border-radius:8px;background:#2563eb;color:#fff;font:500 14px ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color .15s}.ds-btn-primary:hover{background:#3b82f6}.ds-btn-primary:focus-visible{outline:2px solid #93c5fd;outline-offset:2px}.ds-btn-primary:disabled{opacity:.6;cursor:not-allowed}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Bordered button for every other action (Copy, Edit, Open in GitLab).",
      "html": "<button class=\"ds-btn-secondary\">Copy</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border:1px solid #3f3f46;border-radius:8px;background:#18181b;color:#f4f4f5;font:400 14px ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color .15s}.ds-btn-secondary:hover{background:#27272a}.ds-btn-secondary:focus-visible{outline:2px solid #3b82f6;outline-offset:2px}"
    },
    {
      "name": "Verdict Badge",
      "kind": "chip",
      "refersTo": "badge",
      "description": "A verdict, double-coded with icon and word.",
      "html": "<span class=\"ds-verdict\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/><path d=\"m9 11 3 3L22 4\"/></svg>Approve</span>",
      "css": ".ds-verdict{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:9999px;background:rgb(16 185 129/.1);color:#6ee7b7;box-shadow:inset 0 0 0 1px rgb(16 185 129/.3);font:500 12px ui-sans-serif,system-ui,sans-serif}"
    },
    {
      "name": "Open-review Tab",
      "kind": "nav",
      "refersTo": "nav-tab",
      "description": "One entry in the strip of open reviews: state icon, title, unread dot, close.",
      "html": "<nav class=\"ds-strip\"><a class=\"ds-tab\" href=\"#\" aria-current=\"page\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#f87171\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7.86 2h8.28L22 7.86v8.28L16.14 22H7.86L2 16.14V7.86L7.86 2z\"/><path d=\"M12 8v4M12 16h.01\"/></svg><span class=\"ds-tab-t\"><span class=\"ds-mono\">!3909</span> Fix/header skeleton navigation</span></a></nav>",
      "css": ".ds-strip{display:flex;height:40px;border-bottom:1px solid #27272a;background:rgb(24 24 27/.4)}.ds-tab{display:flex;align-items:center;gap:8px;width:224px;padding:0 12px;border-right:1px solid #27272a;border-top:2px solid #ef4444;background:#09090b;color:#f4f4f5;text-decoration:none;font:500 14px ui-sans-serif,system-ui,sans-serif}.ds-tab:focus-visible{outline:2px solid #3b82f6;outline-offset:-2px}.ds-tab-t{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-mono{font:400 12px ui-monospace,Menlo,monospace;color:#a1a1aa;margin-right:6px}"
    },
    {
      "name": "Filter Field",
      "kind": "input",
      "refersTo": "input",
      "description": "The sidebar filter: the whole bordered row is the input.",
      "html": "<label class=\"ds-field\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#71717a\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input class=\"ds-input\" placeholder=\"Filter reviews\u2026\" aria-label=\"Filter reviews\"></label>",
      "css": ".ds-field{display:flex;align-items:center;gap:8px;width:260px;padding:0 10px;border:1px solid #27272a;border-radius:8px;background:#18181b;font:400 14px ui-sans-serif,system-ui,sans-serif}.ds-field:focus-within{border-color:#3b82f6;box-shadow:0 0 0 2px rgb(59 130 246/.5)}.ds-input{flex:1;padding:6px 0;border:0;outline:0;background:transparent;color:#f4f4f5;font:inherit}.ds-input::placeholder{color:#a1a1aa}"
    },
    {
      "name": "Status Mark",
      "kind": "custom",
      "refersTo": "status-mark",
      "description": "A step, job or run state: done, running, pending, failed, skipped.",
      "html": "<span class=\"ds-marks\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" role=\"img\" aria-label=\"Done\"><circle cx=\"8\" cy=\"8\" r=\"8\" fill=\"var(--ok,#34d399)\"/><path d=\"M4.6 8.3l2.2 2.2 4.6-4.8\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><svg class=\"ds-turn\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" role=\"img\" aria-label=\"In progress\"><circle cx=\"8\" cy=\"8\" r=\"6.5\" fill=\"none\" stroke=\"var(--idle,#52525b)\" stroke-width=\"2\" opacity=\".5\"/><circle cx=\"8\" cy=\"8\" r=\"6.5\" fill=\"none\" stroke=\"var(--run,#60a5fa)\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-dasharray=\"12 41\"/><circle cx=\"8\" cy=\"8\" r=\"2\" fill=\"var(--run,#60a5fa)\"/></svg><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" role=\"img\" aria-label=\"Not started\"><circle cx=\"8\" cy=\"8\" r=\"6.5\" fill=\"none\" stroke=\"var(--idle,#52525b)\" stroke-width=\"1.5\" stroke-dasharray=\"2.2 2.4\"/></svg></span>",
      "css": ".ds-marks{display:inline-flex;gap:12px}.ds-turn circle:nth-child(2){transform-origin:center;animation:ds-turn 1s linear infinite}@keyframes ds-turn{to{transform:rotate(360deg)}}"
    },
    {
      "name": "Tool Chip",
      "kind": "chip",
      "refersTo": "tool-chip",
      "description": "The tool an agent action called.",
      "html": "<code class=\"ds-tool\">jira.search</code>",
      "css": ".ds-tool{display:inline-flex;align-items:center;border-radius:6px;padding:1px 6px;font:400 11px/16px ui-monospace,SFMono-Regular,Menlo,monospace;background:var(--sunken,#27272a);color:var(--fg-muted,#a1a1aa);box-shadow:inset 0 0 0 1px var(--line,#27272a)}"
    },
    {
      "name": "Live Pill",
      "kind": "chip",
      "refersTo": "live-pill",
      "description": "Where something stands now: a dot, a word, a measure.",
      "html": "<span class=\"ds-pill\"><span class=\"ds-dot\"></span><b>Running</b><span class=\"ds-m\">\u00b7 2m 19s</span></span>",
      "css": ".ds-pill{display:inline-flex;align-items:center;gap:6px;border-radius:9999px;padding:2px 8px;font:400 12px/16px ui-sans-serif,system-ui,sans-serif;background:var(--sunken,#27272a);color:var(--text,#f4f4f5);box-shadow:inset 0 0 0 1px var(--line,#27272a)}.ds-pill b{font-weight:500}.ds-m{color:var(--fg-muted,#a1a1aa);font-variant-numeric:tabular-nums}.ds-dot{width:6px;height:6px;border-radius:9999px;background:var(--run,#60a5fa);box-shadow:0 0 0 0 var(--run,#60a5fa);animation:ds-ping 1.6s cubic-bezier(.16,1,.3,1) infinite}@keyframes ds-ping{to{box-shadow:0 0 0 5px transparent}}"
    }
  ],
  "narrative": {
    "northStar": "The Reading Desk",
    "overview": "Marginalia's studio is where a person sits down to read what a machine wrote about someone else's code. The desk is the review; everything around it is furniture that stays out of the way and tells the truth about state. Crisp, high-contrast and technical; nothing decorative, nothing playful. Dense by default, flat surfaces separated by hairlines, one loud thing per screen: a status.",
    "keyCharacteristics": [
      "Flat surfaces with thin borders; depth is tonal, shadows are rare and reactive.",
      "Cool graphite neutrals and one signal blue reserved for selection, unread, focus and the main action.",
      "Status is always double-coded: color plus icon or text.",
      "Dense by default, comfortable on touch: 44px targets only on coarse pointers.",
      "Two type voices: system sans for the interface, Recursive for review text.",
      "Confirmed rejection: consumer-app playfulness."
    ],
    "rules": [
      {
        "name": "The Double-Code Rule",
        "body": "A status is never carried by color alone.",
        "section": "colors"
      },
      {
        "name": "The Muted-Text Rule",
        "body": "Secondary sentences use text-fg-muted; raw zinc-500 fails AA on dark surfaces.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "System sans for the interface; only review prose may use Recursive; mono only for code, paths and ids.",
        "section": "typography"
      },
      {
        "name": "The Long-Word Rule",
