# The runner image with a browser, for a project that opts in to browser evidence (ADR 0010):
#   docker build -f deploy/runner/Dockerfile.browser -t marginalia-runner-browser deploy/runner
#   echo VERIFY_RUNNER_IMAGE=marginalia-runner-browser >> .env
# Chromium comes from the distribution (Chrome for Testing has no Linux ARM64 build) and the driver
# is agent-browser, pinned. No secret, no login: the bot starts it like the sample runner (read-only
# root, no capability, limits, no network); Chromium runs with its own sandbox off, the container
# is the boundary.
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ ca-certificates chromium fonts-liberation \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g agent-browser@0.43.0

ENV HOME=/home/runner NPM_CONFIG_UPDATE_NOTIFIER=false NPM_CONFIG_FUND=false AGENT_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
WORKDIR /work
CMD ["sleep", "infinity"]
