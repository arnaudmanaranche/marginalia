{
  "name": "@worldia/marginalia",
  "version": "2.0.0",
  "type": "module",
  "description": "Poller that watches open GitLab MRs, triggers Claude Code headless review, and posts the result as an MR comment.",
  "main": "poll.mjs",
  "bin": {
    "marginalia": "bin/marginalia.mjs"
  },
  "files": [
    "bin",
    "lib",
    "scripts/*.mjs",
    "!scripts/check-file-size.mjs",
    "poll.mjs",
    "studio/*.mjs",
    "studio/public/logo.png",
    "studio/dist",
    "skills",
    "examples",
    "swiftbar",
    ".env.example"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "prepack": "npm --prefix studio ci && npm --prefix studio run build",
    "start": "node poll.mjs",
    "dev": "concurrently -k -n api,studio -c blue,magenta \"npm start\" \"npm run studio:dev\"",
    "setup": "npm install && npm run studio:install && npm run studio:build && npm run init",
    "init": "node scripts/init.mjs",
    "doctor": "node scripts/doctor.mjs",
    "autostart": "node scripts/autostart.mjs",
    "test": "node --test test/*.test.mjs",
    "check:size": "node scripts/check-file-size.mjs",
    "typecheck": "tsc -p .",
    "studio:install": "npm --prefix studio install",
    "studio:build": "npm --prefix studio run build",
    "studio:dev": "npm --prefix studio run dev",
    "studio:storybook": "npm --prefix studio run storybook"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "commander": "^15.0.0",
    "dotenv": "^16.4.5",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^9.2.4",
    "typescript": "^7.0.2"
  }
}
