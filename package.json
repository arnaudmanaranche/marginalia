{
  "name": "marginalia",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Marginalia workspace: the bot (api), the studio (ui) and their contract (packages/contract).",
  "workspaces": [
    "packages/*",
    "api",
    "ui"
  ],
  "scripts": {
    "start": "npm --workspace api start",
    "dev": "concurrently -k -n api,studio -c blue,magenta \"npm start\" \"npm run studio:dev\"",
    "setup": "npm install && npm run studio:build && npm run init",
    "init": "npm --workspace api run init",
    "doctor": "npm --workspace api run doctor --",
    "autostart": "npm --workspace api run autostart --",
    "test": "npm --workspace api test",
    "test:ui": "npm --workspace ui test",
    "check:size": "node scripts/check-file-size.mjs",
    "typecheck": "npm --workspace api run typecheck",
    "posthog:backfill": "npm --workspace api run posthog:backfill --",
    "studio:build": "npm --workspace ui run build",
    "studio:dev": "npm --workspace ui run dev",
    "studio:storybook": "npm --workspace ui run storybook"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^9.2.4",
    "typescript": "^7.0.2"
  }
}
